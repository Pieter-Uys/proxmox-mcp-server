# Copy to /etc/systemd/system/proxmox-mcp.service and adjust the paths.
# Create the service account and set file ownership first: see docs/SETUP.md.
# Set AUDIT_LOG=/var/log/proxmox-mcp/audit.jsonl in the .env file; the
# LogsDirectory line below creates that directory owned by the service user.
# Then: systemctl daemon-reload && systemctl enable --now proxmox-mcp
[Unit]
Description=Proxmox MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxmox-mcp
WorkingDirectory=/opt/proxmox-mcp
EnvironmentFile=/opt/proxmox-mcp/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
LogsDirectory=proxmox-mcp

# Sandboxing. The service only needs to read its code, write its audit log,
# and open network connections (Proxmox API, SSH, Authentik).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/proxmox-mcp
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_UNIX as well as IP: name resolution can go through a local socket
# (systemd-resolved, nscd).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# MemoryDenyWriteExecute is left out on purpose: Node's V8 JIT needs memory
# that is writable and executable, and the service would not start.

[Install]
WantedBy=multi-user.target
