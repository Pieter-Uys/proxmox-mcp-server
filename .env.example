# Copy to .env and fill in. Every value below is a placeholder.
# Load it with: node --env-file=.env server.js   (Node 22 or newer)

# Proxmox API (API token, not a password)
PROXMOX_HOST=pve.example.lan
PROXMOX_PORT=8006
PROXMOX_TOKEN_ID=user@pam!mcp
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_NODE=pve
# CA to trust when Proxmox uses its own certificate, e.g. a copy of /etc/pve/pve-root-ca.pem
# PROXMOX_CA_CERT=/path/to/pve-root-ca.pem

# SSH to the Proxmox host (used by the shell tools)
PROXMOX_SSH_HOST=pve.example.lan
PROXMOX_SSH_PORT=22
PROXMOX_SSH_USER=root
# off (default) | on: connect as a dedicated user (not root) and run pct, qm,
# pvesm, zfs, zpool and ifreload through sudo -n, limited by
# deploy/sudoers.proxmox-mcp. See docs/SETUP.md, step 2.
# PROXMOX_SSH_SUDO=off
# PROXMOX_SSH_KEY=/path/to/id_ed25519
# Required unless SHELL_MODE=off. Fingerprint of the host's SSH key:
#   ssh-keyscan -p <PROXMOX_SSH_PORT> <host> | ssh-keygen -lf -
# Left blank here: the server refuses to start until it is set or waived.
PROXMOX_SSH_HOST_KEY=
# ALLOW_UNPINNED_SSH_HOST=yes   (start without it; not recommended)

# vm_ssh: address ranges it may connect to (comma separated). Default: private
# ranges only (10/8, 172.16/12, 192.168/16, fc00::/7). Narrow it to your VMs.
# VM_SSH_ALLOWED_CIDRS=192.168.10.0/24
# off (default): refuse a password argument and use PROXMOX_SSH_KEY | on
# (on still requires the call to pin the VM's hostKey)
VM_SSH_PASSWORD_AUTH=off

# This server and its OAuth provider (Authentik)
MCP_PORT=3000
# IP to listen on. Default 0.0.0.0 (Docker needs it); 127.0.0.1 if AUTH_MODE is log or off.
# MCP_BIND_ADDRESS=0.0.0.0
MCP_BASE_URL=https://mcp.example.com
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_APP_SLUG=proxmox-mcp
# Required unless AUTH_MODE=off. The provider's Client ID (Applications, Providers).
AUTHENTIK_AUDIENCE=
# ALLOW_ANY_AUDIENCE=yes   (accept tokens for any application; not recommended)

# Security posture
# AUTH_MODE:  enforce (default) | log (accept but record failures) | off
#             log and off also need ALLOW_INSECURE_AUTH=yes, and listen on loopback only
# SHELL_MODE: full (default, risky commands need confirm) | readonly | off
AUTH_MODE=enforce
SHELL_MODE=full
# TOOL_MODE: full (default) | readonly (refuse anything that would need confirm)
TOOL_MODE=full
AUDIT_LOG=./logs/audit.jsonl
# Files cat/head/tail/grep may read on the host without approval (replaces the default:
# /var/log,/sys,/proc,/etc/pve,/etc/network,/etc/hostname,/etc/hosts,/etc/os-release,/etc/apt/sources.list,/etc/apt/sources.list.d)
# READONLY_PATHS=/var/log,/proc,/sys
# true (default): refuse a tool call whose audit entry can't be written | false
AUDIT_REQUIRED=true

# Longest a tool call may hold its HTTP response open, in seconds. Keep it below
# your proxy's and client's own limits.
TOOL_TIMEOUT_SECONDS=90

# Requests per client IP per minute (OAuth and MCP routes). 0 disables.
RATE_LIMIT_PER_MINUTE=120
# Reverse proxy hops in front of the server (1 for a tunnel or single proxy), so
# rate limits apply per real client IP. Leave 0 when exposed directly.
TRUST_PROXY_HOPS=0
# true behind Cloudflare only: record cf-connecting-ip as the client IP (needs TRUST_PROXY_HOPS > 0).
TRUST_CLOUDFLARE_HEADER=false
# Only these users may use the server. Each entry matches one claim: user:NAME,
# email:ADDRESS or sub:ID (no prefix means user:). Unset allows anyone.
# ALLOWED_USERS=user:alice,email:bob@example.com
# Members of these Authentik groups may use the server too.
# ALLOWED_GROUPS=proxmox-admins
