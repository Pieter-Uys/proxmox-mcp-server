# Copy to .env and fill in. Every value below is a placeholder.
# Load it with: node --env-file=.env server.js   (Node 20.6 or newer)

# Proxmox API (API token, not a password)
PROXMOX_HOST=pve.example.lan
PROXMOX_PORT=8006
PROXMOX_TOKEN_ID=user@pam!mcp
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_NODE=pve
# CA to trust when Proxmox uses its own certificate, e.g. a copy of /etc/pve/pve-root-ca.pem
# PROXMOX_CA_CERT=/path/to/pve-root-ca.pem

# SSH to the Proxmox host (used by the shell tools)
PROXMOX_SSH_HOST=pve.example.lan
PROXMOX_SSH_PORT=22
PROXMOX_SSH_USER=root
# PROXMOX_SSH_KEY=/path/to/id_ed25519

# This server and its OAuth provider (Authentik)
MCP_PORT=3000
MCP_BASE_URL=https://mcp.example.com
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_APP_SLUG=proxmox-mcp

# Security posture
# AUTH_MODE:  enforce (default) | log (accept but record failures) | off
# SHELL_MODE: full (default, risky commands need confirm) | readonly | off
AUTH_MODE=enforce
SHELL_MODE=full
AUDIT_LOG=./logs/audit.jsonl

# Requests per client IP per minute (OAuth and MCP routes). 0 disables.
RATE_LIMIT_PER_MINUTE=120
# Reverse proxy hops in front of the server (1 for a tunnel or single proxy), so
# rate limits apply per real client IP. Leave 0 when exposed directly.
TRUST_PROXY_HOPS=0
